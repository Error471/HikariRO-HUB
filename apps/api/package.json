    "fastify": "^5.6.0",
    "ioredis": "^5.8.0",
    "sanitize-html": "^2.18.0",
    "undici": "^7.16.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@hrc/shared": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "domhandler": "^5.0.3",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
