# Configuración para desarrollo en el navegador (pnpm dev).
# La app de escritorio no usa este archivo: genera su configuración y sus claves al arrancar.

# ─── Entorno ─────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Origen público de la web. Las peticiones POST con otro Origin se rechazan (CSRF).
APP_ORIGIN=http://localhost:5173

# ─── HikariRO ────────────────────────────────────────────────────────────
HIKARI_BASE_URL=https://hikariro.com
# Para desarrollar sin conexión: pnpm --filter @hikari-hub/api mock:hikari  y usa:
# HIKARI_BASE_URL=http://localhost:4010   (usuario demo / contraseña demo)
# HIKARI_NEWS_FEED_URL=http://localhost:4010/discord/feed.php
HIKARI_NEWS_FEED_URL=https://api.hikariro.com/discord/feed.php
HIKARI_USER_AGENT=HikariHub/dev
HIKARI_TIMEOUT_MS=10000

# ─── Sesiones ────────────────────────────────────────────────────────────
# Genera los secretos con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# 32 bytes en base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
SESSION_TTL_HOURS=48
SESSION_REVALIDATE_SECONDS=300
# En http://localhost tiene que ser false.
COOKIE_SECURE=false
# Cada cuántos minutos se visita HikariRO para que no cierre la sesión por inactividad (0 = nunca).
KEEPALIVE_MINUTES=5
# "Mantener la sesión iniciada" (guarda la contraseña cifrada). La app de escritorio lo activa sola.
ALLOW_REMEMBER=false

# Opcional: guarda sesiones y favoritos en esta carpeta para no perderlos al reiniciar.
# DATA_DIR=./.data

# ─── Privacidad ─────────────────────────────────────────────────────────
# Contacto del responsable (email o usuario de Discord). Aparece en /privacidad.
# PRIVACY_CONTACT=tu-correo@example.com

# ─── Avisos de MVP ──────────────────────────────────────────────────────
# Solo funcionan en la app de escritorio. Cada cuántos segundos se consulta el MVP Timer (30-600).
ALERT_POLL_SECONDS=60

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
