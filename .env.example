# ─── Entorno ─────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true solo si la API está detrás de un proxy de confianza (Caddy en producción)
TRUST_PROXY=false

# Origen público de la web. Las peticiones POST con otro Origin se rechazan (CSRF).
APP_ORIGIN=http://localhost:5173

# ─── HikariRO ────────────────────────────────────────────────────────────
HIKARI_BASE_URL=https://hikariro.com
# Para desarrollar sin conexión: pnpm --filter @hrc/api mock:hikari  y usa:
# HIKARI_BASE_URL=http://localhost:4010   (usuario demo / contraseña demo)
# HIKARI_NEWS_FEED_URL=http://localhost:4010/discord/feed.php
HIKARI_NEWS_FEED_URL=https://api.hikariro.com/discord/feed.php
HIKARI_USER_AGENT=HikariRO-Companion/0.1 (+https://tu-dominio.example)
HIKARI_TIMEOUT_MS=10000

# ─── Sesiones ────────────────────────────────────────────────────────────
# Genera los secretos con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# 32 bytes en base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
SESSION_TTL_HOURS=48
SESSION_REVALIDATE_SECONDS=300
# En local (http://localhost) puede ser false; en producción SIEMPRE true.
COOKIE_SECURE=false

# Obligatorio en producción. Sin él, en desarrollo se usa memoria.
# REDIS_URL=redis://localhost:6379

# ─── Privacidad ─────────────────────────────────────────────────────────
# Contacto del responsable de esta instancia (email o usuario de Discord). Aparece en /privacidad.
# PRIVACY_CONTACT=tu-correo@example.com

# ─── Avisos push (opcional) ─────────────────────────────────────────────
# Sin estas tres variables los avisos se desactivan. Genera las claves con:
#   pnpm --filter @hrc/api vapid
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@example.com
# Cada cuántos segundos se consulta el MVP Timer para enviar avisos (30-600).
PUSH_POLL_SECONDS=60

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ─── Producción (docker compose) ────────────────────────────────────────
# Dominio público; Caddy obtiene el certificado HTTPS automáticamente.
# DOMAIN=companion.tu-dominio.com
